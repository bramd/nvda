Import(
	"env",
	"sourceDir",
	"localLib",
	"uwpOcrStaticLib",
)


# Ignoring Flake8 F821: 'undefined name' due to nonstandard SCons import
env = env.Clone()  # noqa: F821

# The OCR engine (uwpOcr) is Rust; localWin10.cpp is a tiny stub that anchors
# the CRT + machine + DllMain for the link (the Rust staticlib doesn't). The C
# ABI (from the linked Rust staticlib) is exported via /EXPORT — the Rust
# symbols aren't __declspec(dllexport). (OneCore speech, formerly here as a
# second Rust staticlib, moved to the nvdaRust PyO3 module — see
# rust/nvda_python/src/onecore.rs.)
source = [
	env["projectResFile"],
	"localWin10.cpp",
]
libs = [
	"WindowsApp",
	# Ignoring Flake8 F821: 'undefined name' due to nonstandard SCons import
	localLib[2],  # noqa: F821
]
uwpOcrExports = [
	"uwpOcr_initialize",
	"uwpOcr_terminate",
	"uwpOcr_recognize",
	"uwpOcr_getLanguages",
]
if uwpOcrStaticLib is not None:
	# The Rust staticlib + the system libs the Rust std / windows-core runtime
	# pulls in.
	libs += [
		uwpOcrStaticLib,
		"ntdll",
		"userenv",
		"propsys",
		"bcrypt",
	]
	env.Append(LINKFLAGS=[f"/EXPORT:{name}" for name in uwpOcrExports])

localWin10Lib = env.SharedLibrary(
	target="nvdaHelperLocalWin10",
	source=source,
	LIBS=libs,
)

Return(["localWin10Lib"])
